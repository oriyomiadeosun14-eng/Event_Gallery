DATABASE_URL="mysql://user:password@localhost:3306/event_gallery"

# Only for hosted databases whose certificate isn't publicly trusted (e.g. Aiven):
# paste the CA certificate here. Leave empty for localhost, TiDB Cloud and most others.
DATABASE_CA_CERT=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="wedding"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Password for /admin (pick something long; guests never see it)
ADMIN_PASSWORD="change-me"

# "true" publishes uploads immediately; anything else holds them for review in /admin
AUTO_APPROVE_UPLOADS="false"

# Optional. A short code printed on the QR cards (e.g. "AMELIA26"). When set, guests
# need it (or the QR code) to see the site. Leave empty to keep the site open.
EVENT_PASSCODE=""

# The site's public address, used in the QR code (e.g. "https://amelia-and-james.com").
# If empty, the QR page uses whatever address you opened it on.
NEXT_PUBLIC_SITE_URL=""
